CREATE SCHEMA IF NOT EXISTS auth_service;


CREATE TABLE IF NOT EXISTS auth_service.roles (
    id SERIAL PRIMARY KEY,
    name VARCHAR(255) UNIQUE NOT NULL
);

CREATE TABLE IF NOT EXISTS auth_service.users (
    id BIGSERIAL PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    enabled BOOLEAN,
    refresh_token VARCHAR(512),
    refresh_token_expiry TIMESTAMP WITHOUT TIME ZONE,
    password_reset_token VARCHAR(255),
    password_reset_token_expiry TIMESTAMP WITHOUT TIME ZONE,
    created_at TIMESTAMP WITHOUT TIME ZONE
);

CREATE TABLE IF NOT EXISTS auth_service.users_roles (
    user_id BIGINT NOT NULL,
    role_id INTEGER NOT NULL,
    PRIMARY KEY (user_id, role_id),
    CONSTRAINT fk_users_roles_to_users FOREIGN KEY (user_id) REFERENCES auth_service.users (id) ON DELETE CASCADE,
    CONSTRAINT fk_users_roles_to_roles FOREIGN KEY (role_id) REFERENCES auth_service.roles (id) ON DELETE CASCADE
);


